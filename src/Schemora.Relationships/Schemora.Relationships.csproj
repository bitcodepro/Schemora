<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Schemora.SqlServer/Schemora.SqlServer.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="EmbedEfReferenceMetadata" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <EmbeddedResource
        Include="@(ReferencePath)"
        Condition="$([System.String]::Copy('%(ReferencePath.Identity)').Contains('Microsoft.NETCore.App.Ref')) Or $([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('Microsoft.EntityFrameworkCore')) Or $([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('Microsoft.Extensions.'))"
      >
        <LogicalName>Schemora.Reference/%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
